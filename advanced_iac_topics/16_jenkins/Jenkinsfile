pipeline {
    agent any
    environment {
        YC_CLOUD_ID  = credentials('yc-cloud-id')
        YC_FOLDER_ID = credentials('yc-folder-id')
        YC_KEY_FILE  = credentials('yc-sa-key-json')
    }
    parameters {
        choice(name: 'ACTION', choices: ['plan', 'apply', 'destroy'], description: 'Действие Terraform')
    }
    stages {
        stage('Terraform Init & Validate') {
            steps {
                dir('terraform') {
                    sh 'terraform init'
                    sh 'terraform validate'
                }
            }
        }
        stage('Terraform Plan') {
            steps {
                dir('terraform') {
                    sh 'terraform plan -out=tfplan'
                }
            }
        }
        stage('Terraform Apply & Ansible') {
            when { expression { params.ACTION == 'apply' } }
            steps {
                dir('terraform') {
                    sh 'terraform apply -auto-approve tfplan'
                }
                dir('ansible') {
                    sh 'ansible-playbook -i inventory.ini site.yml'
                }
            }
        }
        stage('Terraform Destroy') {
            when { expression { params.ACTION == 'destroy' } }
            steps {
                dir('terraform') {
                    sh 'terraform destroy -auto-approve'
                }
            }
        }
    }
}
